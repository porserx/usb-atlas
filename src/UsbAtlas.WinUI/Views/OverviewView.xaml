<UserControl
    x:Class="UsbAtlas.WinUI.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UsbAtlas.WinUI.Controls"
    FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollMode="Auto">
        <StackPanel Margin="0,4,8,28" Spacing="14">

            <!-- HERO -->
            <Border Background="{ThemeResource HeroGradient}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="26,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="314" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource Pill}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProfileBadgeText}" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{StaticResource CyanBrush}" CharacterSpacing="80" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{ThemeResource PillBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="LIVE SCAN" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" CharacterSpacing="80" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding BoardName}" Style="{StaticResource HeroTitle}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding BoardMetaLine}" FontSize="10.5" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding HeroNote}" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" Margin="0,5,0,0" MaxWidth="640" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ReconciliationText}" FontSize="9.5" Foreground="{StaticResource CyanBrush}" Margin="0,3,0,0" Opacity="0.9" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Border Width="1" Background="{ThemeResource CardBorderBrush}" HorizontalAlignment="Left" Margin="0,8,0,8" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4" Margin="26,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                <TextBlock Text="{Binding PhysicalPortCount}" FontFamily="{StaticResource DisplayFont}" FontSize="66"
                                           FontWeight="SemiBold" Foreground="{ThemeResource BrandGradient}" />
                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,12" Spacing="1">
                                    <TextBlock Text="个" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="物理 USB 接口" FontSize="9.5" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Background="{ThemeResource PillBackgroundBrush}">
                                <TextBlock Text="{Binding VersionHeadline}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SourceCaption}" FontSize="8" Foreground="{ThemeResource TextMutedBrush}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- STATS -->
            <ItemsRepeater ItemsSource="{Binding StatCards}" ItemTemplate="{StaticResource StatCardTemplate}" Margin="0,2,0,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="205" MinColumnSpacing="10" MinRowSpacing="10"
                                       MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!-- COMPOSITION + LIVE -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="版本构成" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="物理接口按 USB 代际分布 · 理论有效速率" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource PillBackgroundBrush}">
                                <TextBlock Text="{Binding VersionHeadline}" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <controls:DistributionBar Segments="{Binding VersionSegments}" />
                        <ItemsRepeater ItemsSource="{Binding VersionStats}" ItemTemplate="{StaticResource VersionTileCompactTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="110" MinColumnSpacing="8" MinRowSpacing="8"
                                                   MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <TextBlock Text="Gen 2x2 / Gen 2 / Gen 1 的口径来自主板官方规格；Windows 实时扫描只能识别 USB 3.x 协议族。"
                                   Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="实时拓扑" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Windows USB Hub 实时扫描" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ScanTimeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                           Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding RootLaneCount}" FontFamily="{StaticResource DisplayFont}" FontSize="25"
                                           FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" />
                                <TextBlock Text="根端口通道" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="{Binding UserGroupCount}" FontFamily="{StaticResource DisplayFont}" FontSize="25"
                                           FontWeight="SemiBold" Foreground="{StaticResource VioletBrush}" />
                                <TextBlock Text="用户可连接" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="1">
                                <TextBlock Text="{Binding ConnectedDeviceCount}" FontFamily="{StaticResource DisplayFont}" FontSize="25"
                                           FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                                <TextBlock Text="已连接设备" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <Grid Height="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Usb2LaneWidth}" />
                                    <ColumnDefinition Width="{Binding Usb3LaneWidth}" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource CyanBrush}" CornerRadius="4" Margin="0,0,2,0" />
                                <Border Grid.Column="1" Background="{StaticResource VioletBrush}" CornerRadius="4" Margin="2,0,0,0" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="根端口构成" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" />
                                <TextBlock Text="{Binding LaneComposition}" FontSize="8" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <ItemsRepeater ItemsSource="{Binding Controllers}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="48" ColumnSpacing="10" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{Binding SoftBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource MonoFont}" FontSize="8.5" FontWeight="SemiBold"
                                                       Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PortsSummary}" FontSize="8" Foreground="{ThemeResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding ConnectedLabel}" FontSize="8.5" Foreground="{Binding AccentBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding UserGroupLabel}" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <TextBlock Text="{Binding LaneHeadline}" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- REAR I/O -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="13">
                    <Grid>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding RearSectionTitle}" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource Pill}" Padding="8,3" Background="{ThemeResource PillBackgroundBrush}">
                                    <TextBlock Text="{Binding RearSectionSubtitle}" FontSize="8.3" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="按主板官方规格排列 · 颜色表示 USB 代际" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource PinkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Type-C" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource VioletBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="USB 3.2" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="5" Height="5" Fill="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="USB 2.0" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <ItemsRepeater ItemsSource="{Binding RearPorts}" ItemTemplate="{StaticResource PortCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="108" MinColumnSpacing="9" MinRowSpacing="9"
                                               MaximumRowsOrColumns="8" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <TextBlock Text="接口数量与代际来自主板官方规格；实时连接状态请查看下方设备列表。" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>

            <!-- FRONT + DEVICES -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding FrontSectionTitle}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding FrontSectionSubtitle}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource PillBackgroundBrush}">
                                <TextBlock Text="含接针" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                            </Border>
                        </Grid>
                        <ItemsRepeater ItemsSource="{Binding FrontGroups}" ItemTemplate="{StaticResource FrontGroupTemplate}"
                                       Visibility="{Binding ProfileMatched, Converter={StaticResource BoolToVis}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <Border Style="{StaticResource InnerCard}" Padding="14"
                                Visibility="{Binding ProfileMatched, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="未匹配主板规格档案。系统识别到的用户可连接接口已在上方按 USB 版本聚合显示。"
                                       FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1" Padding="20">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="已连接设备" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding ConnectedHeadline}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource PillBackgroundBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="LIVE" FontSize="7.8" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ItemsRepeater ItemsSource="{Binding PreviewDevices}" ItemTemplate="{StaticResource DeviceCompactTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <Button Style="{StaticResource GhostAction}" HorizontalAlignment="Right" Click="ViewAllDevices_Click" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="查看全部设备" FontSize="9.5" />
                                <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding FooterNote}" Style="{StaticResource Muted}" Margin="2,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
