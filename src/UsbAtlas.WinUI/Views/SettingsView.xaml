<UserControl
    x:Class="UsbAtlas.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,8,28" Spacing="14">

            <Border Background="{ThemeResource HeroGradient}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="26,22">
                <StackPanel Spacing="7">
                    <TextBlock Text="PERSONALIZE / SETTINGS" Style="{StaticResource Kicker}" Foreground="{ThemeResource CyanBrush}" />
                    <TextBlock Text="让 USB Atlas 更适合你" Style="{StaticResource HeroTitle}" />
                    <TextBlock Text="应用主题、设备显示与扫描操作都保存在本地。所有设置立即生效。"
                               Style="{StaticResource Caption}" MaxWidth="720" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource PillBackgroundBrush}">
                            <FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                      Foreground="{ThemeResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="应用主题" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="跟随系统会自动匹配 Windows 的浅色或深色模式。" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <RadioButtons x:Name="ThemeOptions" Grid.Column="2" MaxColumns="3"
                                      SelectionChanged="ThemeOptions_SelectionChanged" VerticalAlignment="Center">
                            <x:String>跟随系统</x:String>
                            <x:String>浅色</x:String>
                            <x:String>深色</x:String>
                        </RadioButtons>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource SubtleBorderBrush}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource PillBackgroundBrush}">
                            <FontIcon Glyph="&#xE81E;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                      Foreground="{ThemeResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="窗口材质" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="Mica 使用桌面壁纸的柔和色调；Mica Alt 对比更强。仅 Windows 11 生效。" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <RadioButtons x:Name="BackdropOptions" Grid.Column="2" MaxColumns="2"
                                      SelectionChanged="BackdropOptions_SelectionChanged" VerticalAlignment="Center">
                            <x:String>Mica</x:String>
                            <x:String>Mica Alt</x:String>
                        </RadioButtons>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="设备列表" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource PillBackgroundBrush}">
                            <FontIcon Glyph="&#xE772;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                      Foreground="{ThemeResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="显示内置设备" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="蓝牙、灯控、板载集线器等内置链路也会出现在设备列表中。" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ShowInternalToggle" Grid.Column="2" OnContent="显示" OffContent="隐藏"
                                      Toggled="ShowInternalToggle_Toggled" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="操作" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource PillBackgroundBrush}">
                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                      Foreground="{ThemeResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="重新扫描硬件" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="重新读取 USB 根集线器、端口与设备描述符。" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button x:Name="RescanButton" Grid.Column="2" Style="{StaticResource PrimaryAction}"
                                Click="Rescan_Click" Content="重新扫描" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource SubtleBorderBrush}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource PillBackgroundBrush}">
                            <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                      Foreground="{ThemeResource AmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="诊断报告" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="将本次扫描的主板、接口、主控与设备数据复制为 JSON。" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostAction}" Click="CopyReport_Click"
                                Content="复制 JSON" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="应用版本" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Text="扫描引擎" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScanEngineLabel}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Text="界面框架" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="WinUI 3 · Windows App SDK 1.8" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Text="配置文件" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SettingsPathText" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                    </Grid>
                    <HyperlinkButton x:Name="SpecLinkButton" Content="打开华硕支持页面" Click="SpecLink_Click"
                                     Padding="0" FontSize="10" Foreground="{ThemeResource CyanBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="USB Atlas · Native WinUI 3 · 本地只读扫描" Style="{StaticResource Muted}" Margin="2,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
