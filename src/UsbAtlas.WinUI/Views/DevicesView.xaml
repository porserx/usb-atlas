<UserControl
    x:Class="UsbAtlas.WinUI.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,8,28" Spacing="14">

            <Border Background="{ThemeResource HeroGradient}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="26,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="270" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock Text="LIVE DEVICES / WINDOWS USB TOPOLOGY" Style="{StaticResource Kicker}" Foreground="{StaticResource GreenBrush}" />
                        <TextBlock Text="Windows 正在使用的 USB 通道" Style="{StaticResource HeroTitle}" />
                        <TextBlock Text="{Binding LaneHeadline}" FontSize="10.5" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Style="{StaticResource Pill}" Background="{ThemeResource PillBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="LIVE" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding ScanTimeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding ScanStatus}" FontSize="8.2" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding ConnectedDeviceCount}" FontFamily="{StaticResource DisplayFont}" FontSize="67"
                                   FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="台设备已连接" FontSize="9" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ConnectedHeadline}" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="15">
                    <StackPanel Spacing="3">
                        <TextBlock Text="主控" Style="{StaticResource Kicker}" FontSize="8.5" />
                        <TextBlock Text="{Binding ControllerCount}" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyanBrush}" />
                        <TextBlock Text="xHCI 控制器" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="15" Grid.Column="1">
                    <StackPanel Spacing="3">
                        <TextBlock Text="根端口" Style="{StaticResource Kicker}" FontSize="8.5" />
                        <TextBlock Text="{Binding RootLaneCount}" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{StaticResource VioletBrush}" />
                        <TextBlock Text="USB 2.0 / 3.x 通道" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="15" Grid.Column="2">
                    <StackPanel Spacing="3">
                        <TextBlock Text="用户接口" Style="{StaticResource Kicker}" FontSize="8.5" />
                        <TextBlock Text="{Binding UserGroupCount}" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{StaticResource AmberBrush}" />
                        <TextBlock Text="ACPI 可连接组" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="15" Grid.Column="3">
                    <StackPanel Spacing="3">
                        <TextBlock Text="内置" Style="{StaticResource Kicker}" FontSize="8.5" />
                        <TextBlock Text="{Binding InternalDeviceCount}" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="蓝牙 / 灯控 / 接针" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <StackPanel Spacing="3">
                    <TextBlock Text="USB 主控通道" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="每个根端口都是一条独立 USB 通道；USB 2.0 与 USB 3.x 可能共享同一个物理接口。"
                               Style="{StaticResource Caption}" />
                </StackPanel>
                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="根端口明细" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                </Border>
            </Grid>

            <ItemsRepeater ItemsSource="{Binding Controllers}" ItemTemplate="{StaticResource ControllerTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="已连接设备" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ConnectedHeadline}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource PillBackgroundBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="LIVE" FontSize="7.8" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,4,0,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="2.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="设备" Style="{StaticResource Kicker}" FontSize="7.8" />
                        <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource Kicker}" FontSize="7.8" />
                        <TextBlock Grid.Column="3" Text="协议" Style="{StaticResource Kicker}" FontSize="7.8" />
                        <TextBlock Grid.Column="4" Text="位置 / 速率" Style="{StaticResource Kicker}" FontSize="7.8" />
                        <TextBlock Grid.Column="5" Text="VID:PID" Style="{StaticResource Kicker}" FontSize="7.8" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRowTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <TextBlock Text="设备列表为根端口直连设备；外接集线器后的键鼠等设备可能显示为集线器本身。"
                               Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock Text="为什么根端口比物理接口多？" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="USB 3.x 接口通常包含一条 USB 2.0 和一条 USB 3.x 通道；Windows 会把它们分别显示为根端口。应用已按连接器属性合并共享同一物理接口的通道。"
                                   Style="{StaticResource Caption}" MaxWidth="820" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="14" VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding InternalGroupCount}" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                       FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="内置 / 非外露通道" FontSize="7.8" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{Binding FooterNote}" Style="{StaticResource Muted}" Margin="2,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
