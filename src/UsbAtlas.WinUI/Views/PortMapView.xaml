<UserControl
    x:Class="UsbAtlas.WinUI.Views.PortMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,8,28" Spacing="14">

            <Border Background="{ThemeResource HeroGradient}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="26,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="270" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock Text="PORT MAP / PHYSICAL LAYOUT" Style="{StaticResource Kicker}" Foreground="{StaticResource CyanBrush}" />
                        <TextBlock Text="主板物理 USB 接口布局" Style="{StaticResource HeroTitle}" />
                        <TextBlock Text="{Binding SourceCaption}" FontSize="10.5" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ReconciliationText}" FontSize="9.5" Foreground="{StaticResource CyanBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Style="{StaticResource Pill}" Background="{ThemeResource PillBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}">
                                <TextBlock Text="{Binding ProfileSourceLabel}" FontSize="8.2" Foreground="{StaticResource GreenBrush}" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding ProfileVerifiedLabel}" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding PhysicalPortCount}" FontFamily="{StaticResource DisplayFont}" FontSize="67"
                                   FontWeight="SemiBold" Foreground="{ThemeResource BrandGradient}" HorizontalAlignment="Right" />
                        <TextBlock Text="物理接口总数" FontSize="9" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding VersionHeadline}" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.62*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="13">
                        <Grid>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding RearSectionTitle}" Style="{StaticResource SectionTitle}" />
                                    <Border Style="{StaticResource Pill}" Padding="8,3">
                                        <TextBlock Text="{Binding RearSectionSubtitle}" FontSize="8.2" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="官方规格布局 · 颜色表示 USB 代际" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource PinkBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Type-C" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource VioletBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="USB 3.2" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ItemsRepeater ItemsSource="{Binding RearPorts}" ItemTemplate="{StaticResource PortCardMapTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinColumnSpacing="10" MinRowSpacing="10"
                                                   MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1" Padding="20">
                    <StackPanel Spacing="13">
                        <StackPanel Spacing="3">
                            <TextBlock Text="版本索引" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="数量、信号速率与理论有效速率" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{Binding VersionStats}" ItemTemplate="{StaticResource VersionTileTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <Border Background="{ThemeResource InnerCardBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <TextBlock Text="Windows 实时扫描无法区分空口的 Gen 1 / Gen 2，因此 Gen 版本以主板官方规格为准。"
                                       Style="{StaticResource Muted}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20"
                    Visibility="{Binding ProfileMatched, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="13">
                    <Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding FrontSectionTitle}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding FrontSectionSubtitle}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="前面板接针" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                        </Border>
                    </Grid>
                    <ItemsRepeater ItemsSource="{Binding FrontGroups}" ItemTemplate="{StaticResource FrontGroupTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10">
                        <TextBlock Text="口径说明" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="官方物理接口数量与 Windows 实时拓扑采用不同口径，两者并不矛盾。"
                                   Style="{StaticResource Caption}" />
                        <ItemsRepeater ItemsSource="{Binding DataNotes}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="7" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource CyanBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="9" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="14" VerticalAlignment="Top">
                        <StackPanel Spacing="7">
                            <TextBlock Text="实时校验" Style="{StaticResource Kicker}" Foreground="{StaticResource GreenBrush}" />
                            <TextBlock Text="{Binding LaneHeadline}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ConnectedHeadline}" FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding FooterNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{Binding FooterNote}" Style="{StaticResource Muted}" Margin="2,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
