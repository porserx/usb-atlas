<UserControl
    x:Class="UsbAtlas.WinUI.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,8,28" Spacing="14">

            <Border Background="{ThemeResource HeroGradient}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="26,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock Text="DATA METHOD / SOURCE &amp; CAVEATS" Style="{StaticResource Kicker}" Foreground="{StaticResource VioletBrush}" />
                        <TextBlock Text="数据从哪里来？" Style="{StaticResource HeroTitle}" />
                        <TextBlock Text="接口数量和 Gen 版本来自主板规格档案，连接状态与设备来自 Windows 原生 USB 拓扑；两者分层展示，不把规格数据伪装成实时结果。"
                                   FontSize="10.5" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Style="{StaticResource Pill}" Background="{ThemeResource PillBackgroundBrush}">
                                <TextBlock Text="LOCAL ONLY" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" CharacterSpacing="60" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="NO ADMIN" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextMutedBrush}" CharacterSpacing="60" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="NO DRIVER" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextMutedBrush}" CharacterSpacing="60" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <FontIcon Grid.Column="1" Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="92"
                              Foreground="{StaticResource VioletBrush}" Opacity="0.16" VerticalAlignment="Center" Margin="20,0,0,0" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{ThemeResource PillBackgroundBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="01" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="官方规格档案" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="按厂商 + 型号匹配 board-profiles.json，提供物理接口数量与 Gen 版本口径。"
                                   FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Grid.Column="1">
                    <StackPanel Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{ThemeResource PillBackgroundBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="02" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="原生 USB 扫描" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="通过 SetupAPI 打开 USB Hub，读取根端口、协议、连接器属性和设备描述符；无需安装驱动。"
                                   FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Grid.Column="2">
                    <StackPanel Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{ThemeResource PillBackgroundBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="03" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="本地、只读" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="所有信息在本机读取，不上传网络；普通用户权限即可运行，不修改系统 USB 设置。"
                                   FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="数据口径" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="为什么官方数量与实时识别数量可能不同" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{Binding DataNotes}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                  Foreground="{StaticResource CyanBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="本次扫描的上下文" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{Binding EnvironmentItems}" ItemTemplate="{StaticResource KeyValueTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="主板规格来源" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SourceCaption}" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ProfileSourceLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                            <TextBlock Text="{Binding ProfileVerifiedLabel}" FontSize="8.8" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <HyperlinkButton x:Name="SpecLinkButton" Content="打开华硕支持页面" Click="SpecLink_Click" Padding="0"
                                         Foreground="{StaticResource CyanBrush}" FontSize="10" />
                        <TextBlock Text="在新浏览器中打开" FontSize="7.8" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="USB ATLAS" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" CharacterSpacing="40" />
                        <TextBlock Text="主板 USB 接口图鉴 · 本地 WinUI 3 应用" FontSize="9.5" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="Native USB Hub IOCTL + 主板规格档案" FontFamily="{StaticResource MonoFont}" FontSize="8.4"
                                   Foreground="{ThemeResource TextMutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                            <TextBlock Text="v" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock Text="{Binding AppVersion}" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ScanDurationLabel}" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding FooterNote}" Style="{StaticResource Muted}" Margin="2,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
