<UserControl
    x:Class="UsbAtlas.WinUI.Views.CreditsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,8,28" Spacing="14">

            <Border Background="{ThemeResource HeroGradient}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="26,22">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="82" Height="82" CornerRadius="22" Background="{ThemeResource PortTileBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/usb-atlas.png" Width="64" Height="64" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="ABOUT / CREDITS" Style="{StaticResource Kicker}" Foreground="{ThemeResource CyanBrush}" />
                        <TextBlock Text="USB Atlas" Style="{StaticResource HeroTitle}" />
                        <TextBlock Text="主板 USB 接口图鉴 · 本地只读硬件扫描" Style="{StaticResource Caption}" MaxWidth="680"
                                   HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="WinUI 3" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource CyanBrush}" CharacterSpacing="50" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{ThemeResource PillBackgroundBrush}">
                                <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="8" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{ThemeResource PillBackgroundBrush}">
                                <TextBlock Text="MIT License" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" CharacterSpacing="40" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="作者" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource PillBackgroundBrush}"
                                    BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1">
                                <TextBlock Text="PX" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{ThemeResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="porserx" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="设计 / 开发" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center">
                                <TextBlock Text="AUTHOR" FontSize="7.5" Foreground="{ThemeResource TextMutedBrush}" CharacterSpacing="60" />
                            </Border>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource PillBackgroundBrush}"
                                    BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1">
                                <TextBlock Text="EX" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{ThemeResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="EXET" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="设计 / 开发" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center">
                                <TextBlock Text="AUTHOR" FontSize="7.5" Foreground="{ThemeResource TextMutedBrush}" CharacterSpacing="60" />
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource SubtleBorderBrush}" />
                        <TextBlock Text="由 porserx &amp; EXET 共同设计与开发。如果这个工具帮你认清了主板的 USB 接口，欢迎在 GitHub 上点一个 Star。"
                                   Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="开源协议" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{ThemeResource PillBackgroundBrush}">
                                <TextBlock Text="MIT" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" CharacterSpacing="60" />
                            </Border>
                        </Grid>
                        <TextBlock Text="MIT License" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="Copyright © 2026 porserx &amp; EXET" Style="{StaticResource Caption}" />
                        <TextBlock Text="可自由使用、修改、合并、发布、再授权或销售，唯一要求是保留版权声明和本许可声明。软件按“原样”提供，不附带担保。"
                                   Style="{StaticResource Caption}" />
                        <Expander Header="查看 MIT 协议全文" HorizontalAlignment="Stretch">
                            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LicenseBody" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                           Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="源代码" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="完整 WinUI 3 工程（XAML、C#、主板规格档案、构建脚本）已开源在 GitHub；发布包中还附带一份可离线使用的源码压缩包。"
                               Style="{StaticResource Caption}" MaxWidth="880" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource PrimaryAction}" Click="Repo_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                <TextBlock Text="打开 GitHub 仓库" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostAction}" Click="SourceZip_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                <TextBlock Text="打开本地源码包" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="RepoUrlText" Text="https://github.com/porserx/usb-atlas"
                               FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{ThemeResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="技术栈" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="WinUI 3 · Windows App SDK 1.8 · .NET 8 · x64" Style="{StaticResource Caption}" />
                        <TextBlock Text="界面使用原生 Fluent 控件、Mica / Mica Alt、NavigationView 与自绘 USB 接口图标；数据层使用 SetupAPI 和 USB Hub IOCTL。"
                                   Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="隐私" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="所有扫描都在本机完成，不上传硬件信息；应用不安装驱动、不修改 USB 设置、不写入设备。"
                                   Style="{StaticResource Caption}" />
                        <TextBlock Text="源代码和 MIT 许可是这个项目可审计、可复用的基础。" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="USB Atlas · Made by porserx &amp; EXET · MIT License · 2026" Style="{StaticResource Muted}"
                       Margin="2,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
