<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UsbAtlas.WinUI.Controls">

    <DataTemplate x:Key="StatCardTemplate">
        <Border Style="{StaticResource Card}" Padding="16" Height="120" Margin="0,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding AccentBrush}" CornerRadius="2" Margin="0,4,0,4" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Index}" Style="{StaticResource Kicker}" FontSize="8.5" Foreground="{Binding AccentBrush}" />
                            <TextBlock Text="{Binding Kicker}" Style="{StaticResource Kicker}" FontSize="8.5" />
                        </StackPanel>
                        <Ellipse Fill="{Binding AccentBrush}" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="31" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                        <TextBlock Text="{Binding Unit}" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                    </StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}" FontSize="9.2" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PortCardTemplate">
        <Border Style="{StaticResource PortTile}" MinHeight="152" ToolTipService.ToolTip="{Binding TheoreticalDetail}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding IndexLabel}" Style="{StaticResource Kicker}" FontSize="8.2" />
                    <Border Grid.Column="1" Background="{Binding SoftBrush}" CornerRadius="8" Padding="6,2" Margin="0,0,2,0">
                        <TextBlock Text="{Binding SpeedBadge}" FontSize="8.2" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                    </Border>
                </Grid>
                <controls:PortGlyph Grid.Row="1" Width="56" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    PortType="{Binding PortType}" AccentBrush="{Binding AccentBrush}" SoftBrush="{Binding SoftBrush}" />
                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="{Binding Version}" FontSize="9.8" FontWeight="SemiBold" Foreground="{Binding AccentBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding TypeLabel}" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="·" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SpeedLabel}" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TheoreticalShortLabel}" FontSize="7.4" Foreground="{ThemeResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PortCardMapTemplate">
        <Border Style="{StaticResource PortTile}" MinHeight="160" ToolTipService.ToolTip="{Binding TheoreticalDetail}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding IndexLabel}" Style="{StaticResource Kicker}" FontSize="8.2" />
                    <Border Grid.Column="1" Background="{Binding SoftBrush}" CornerRadius="8" Padding="6,2" Margin="0,0,2,0">
                        <TextBlock Text="{Binding SpeedBadge}" FontSize="8.2" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                    </Border>
                </Grid>
                <controls:PortGlyph Grid.Row="1" Width="60" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    PortType="{Binding PortType}" AccentBrush="{Binding AccentBrush}" SoftBrush="{Binding SoftBrush}" />
                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="{Binding Version}" FontSize="9.8" FontWeight="SemiBold" Foreground="{Binding AccentBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding TypeLabel}" FontSize="8.5" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="·" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SpeedLabel}" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TheoreticalShortLabel}" FontSize="7.4" Foreground="{ThemeResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="VersionTileTemplate">
        <Border Style="{StaticResource InnerCard}" Padding="12" ToolTipService.ToolTip="{Binding TheoreticalDetail}">
            <StackPanel Spacing="8">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Fill="{Binding AccentBrush}" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Count}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Value="{Binding Percent}" Maximum="100" Height="4"
                             Foreground="{Binding AccentBrush}" Background="{ThemeResource PillBackgroundBrush}" />
                <TextBlock Text="{Binding SubLabel}" FontSize="8.8" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding TheoreticalLabel}" FontSize="8.4" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="VersionTileCompactTemplate">
        <Border Style="{StaticResource InnerCard}" Padding="10" ToolTipService.ToolTip="{Binding TheoreticalDetail}">
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="{Binding Label}" FontSize="9.2" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="82" />
                    <TextBlock Text="{Binding Count}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Value="{Binding Percent}" Maximum="100" Height="3"
                             Foreground="{Binding AccentBrush}" Background="{ThemeResource PillBackgroundBrush}" />
                <TextBlock Text="{Binding SubLabel}" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding TheoreticalLabel}" FontSize="7.8" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="FrontGroupTemplate">
        <Border Style="{StaticResource InnerCard}" Padding="12" Margin="0,0,0,8">
            <StackPanel Spacing="9">
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Header}" FontSize="10.8" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Background="{Binding SoftBrush}" CornerRadius="10" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountLabel}" FontSize="8.5" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="84" MinHeight="116" CornerRadius="12" Padding="6,10" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" ToolTipService.ToolTip="{Binding TheoreticalDetail}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <controls:PortGlyph Width="48" Height="32" PortType="{Binding PortType}"
                                                        AccentBrush="{Binding AccentBrush}" SoftBrush="{Binding SoftBrush}" />
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="8.6" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SpeedBadge}" FontSize="8.2" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TheoreticalShortLabel}" FontSize="7.2" Foreground="{ThemeResource TextMutedBrush}"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="72" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DeviceCompactTemplate">
        <Grid Height="60" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="9" Background="{Binding SoftBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="{Binding IconGlyph}" FontSize="15" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontSize="10.6" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="238" />
                    <Border Background="{ThemeResource PillBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScopeLabel}" FontSize="7.5" Foreground="{ThemeResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding ManufacturerLabel}" FontSize="8.6" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="3">
                <Border Background="{Binding SoftBrush}" CornerRadius="7" Padding="6,2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SpeedLabel}" FontSize="8.2" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                </Border>
                <TextBlock Text="{Binding VersionLabel}" FontSize="7.8" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DeviceRowTemplate">
        <Border BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
            <Grid Height="48" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" Background="{Binding SoftBrush}" VerticalAlignment="Center">
                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="14" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="10.6" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Background="{ThemeResource PillBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScopeLabel}" FontSize="7.3" Foreground="{ThemeResource TextMutedBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ManufacturerLabel}" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="3" Background="{Binding SoftBrush}" CornerRadius="7" Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding VersionLabel}" FontSize="7.8" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding PortLine}" FontSize="8.4" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SpeedLabel}" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="{Binding VidPid}" FontFamily="{StaticResource MonoFont}" FontSize="8"
                           Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="LiveGroupTemplate">
        <Border Style="{StaticResource InnerCard}" Padding="9,7" CornerRadius="9" Opacity="{Binding Opacity}"
                ToolTipService.ToolTip="{Binding Tooltip}">
            <StackPanel Spacing="2">
                <Grid>
                    <TextBlock Text="{Binding PortsLabel}" FontSize="8.4" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding VersionLabel}" FontSize="8.2" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                <TextBlock Text="{Binding StatusLabel}" FontSize="7.5" Foreground="{ThemeResource TextMutedBrush}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ControllerTemplate">
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
            <StackPanel Spacing="14">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="40" Height="40" CornerRadius="11" Background="{Binding SoftBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ControllerId}" FontFamily="{StaticResource MonoFont}" FontSize="8.4"
                                       Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding ConnectedLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding UserGroupLabel}" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Grid Height="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Usb2Width}" />
                        <ColumnDefinition Width="{Binding Usb3Width}" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CyanBrush}" CornerRadius="4" Margin="0,0,2,0" />
                    <Border Grid.Column="1" Background="{StaticResource VioletBrush}" CornerRadius="4" Margin="2,0,0,0" />
                </Grid>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding RootPorts}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="根端口" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Usb2Lanes}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyanBrush}" />
                        <TextBlock Text="USB 2.0 通道" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="1">
                        <TextBlock Text="{Binding Usb3Lanes}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource VioletBrush}" />
                        <TextBlock Text="USB 3.x 通道" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="1">
                        <TextBlock Text="{Binding ConnectedCount}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource GreenBrush}" />
                        <TextBlock Text="已连接" FontSize="8.2" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>

                <ItemsRepeater ItemsSource="{Binding LiveGroups}" ItemTemplate="{StaticResource LiveGroupTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="124" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="KeyValueTemplate">
        <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Key}" FontSize="8.8" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="9.6" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
