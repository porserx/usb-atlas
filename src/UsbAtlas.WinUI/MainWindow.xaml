<Window
    x:Class="UsbAtlas.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:UsbAtlas.WinUI.Views"
    Title="USB Atlas · 主板 USB 接口图鉴">

    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="ms-appx:///Assets/usb-atlas.png" Width="19" Height="19" />
                <TextBlock Text="USB ATLAS" FontFamily="{StaticResource DisplayFont}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" CharacterSpacing="60" />
                <Border Width="1" Height="12" Background="{ThemeResource SubtleBorderBrush}" Margin="3,0" />
                <TextBlock Text="MOTHERBOARD USB ATLAS" FontSize="7.5" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" CharacterSpacing="80" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                <Ellipse Width="5" Height="5" Fill="{Binding ScanStatusBrush}" VerticalAlignment="Center" />
                <TextBlock Text="LIVE HARDWARE" FontSize="7.5" FontWeight="SemiBold" Foreground="{ThemeResource TextMutedBrush}"
                           VerticalAlignment="Center" CharacterSpacing="70" />
                <TextBlock Text="·" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ScanStatusDetail}" FontSize="7.5" Foreground="{ThemeResource TextMutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </StackPanel>
            <Border Grid.ColumnSpan="3" Height="1" Background="{ThemeResource SubtleBorderBrush}" VerticalAlignment="Bottom" />
        </Grid>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        Background="Transparent"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="232"
                        CompactPaneLength="60"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Nav_SelectionChanged"
                        AlwaysShowHeader="False">
            <NavigationView.PaneHeader>
                <StackPanel Margin="14,12,14,0" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{ThemeResource PillBackgroundBrush}"
                                BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1">
                            <Image Source="ms-appx:///Assets/usb-atlas.png" Width="28" Height="28" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="USB ATLAS" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" CharacterSpacing="50" />
                            <TextBlock Text="主板接口图鉴" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="工作台" Style="{StaticResource Kicker}" Margin="4,0,0,0" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavOverviewItem" Content="总览" Tag="overview" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavPortsItem" Content="接口图谱" Tag="ports">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE88E;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDevicesItem" Content="实时设备" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE772;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAboutItem" Content="检测说明" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavCreditsItem" Content="关于" Tag="credits">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettingsItem" Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="10,0,10,12" Spacing="10">
                    <Border Style="{StaticResource InnerCard}" Padding="12">
                        <StackPanel Spacing="4">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="6" Height="6" Fill="{Binding ScanStatusBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ScanStatus}" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ScanTimeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                           Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding BoardName}" FontSize="9.5" Foreground="{ThemeResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LaneHeadline}" FontSize="8" Foreground="{ThemeResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Height="1" Background="{ThemeResource SubtleBorderBrush}" Margin="0,4,0,3" />
                            <Grid>
                                <TextBlock Text="用户接口" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" />
                                <TextBlock Text="{Binding UserGroupCount}" FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource CyanBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="已连接设备" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ConnectedDeviceCount}" FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource GreenBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v1.0 · WINUI 3" Style="{StaticResource Kicker}" FontSize="7.5" Margin="2,0,0,0" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Page header -->
                    <Grid Margin="28,16,28,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <BreadcrumbBar x:Name="Breadcrumb" Margin="0,0,0,1" />
                            <TextBlock x:Name="PageTitleText" Text="主板 USB 接口图鉴" Style="{StaticResource PageTitle}" />
                            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,2,0,0">
                                <TextBlock Text="{Binding BoardName}" FontSize="9.5" Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Pill}" Padding="7,2">
                                    <TextBlock Text="{Binding ProfileSourceLabel}" FontSize="7.8" Foreground="{ThemeResource TextMutedBrush}" />
                                </Border>
                                <TextBlock Text="{Binding ScanStatusDetail}" FontSize="8.3" Foreground="{ThemeResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Pill}" Padding="10,6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="5" Height="5" Fill="{Binding ScanStatusBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ScanDateLabel}" FontSize="8" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ScanTimeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="8.3"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <CommandBar x:Name="PageCommands" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False"
                                            Background="Transparent" Padding="0" VerticalAlignment="Center">
                                    <CommandBar.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
                                    </CommandBar.KeyboardAccelerators>
                                    <AppBarButton x:Name="RefreshCommand" Label="重新扫描" Click="Refresh_Click"
                                                  ToolTipService.ToolTip="重新扫描 (F5)"
                                                  AutomationProperties.Name="重新扫描"
                                                  IsEnabled="{Binding IsNotScanning}">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Label="复制报告" Click="CopyReport_Click"
                                                  ToolTipService.ToolTip="复制诊断报告"
                                                  AutomationProperties.Name="复制诊断报告">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Label="设置" Click="Settings_Click"
                                                  ToolTipService.ToolTip="打开设置"
                                                  AutomationProperties.Name="打开设置">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBar>
                            </StackPanel>
                            <TextBlock Text="F5 重新扫描 · 数据仅在本机读取" FontSize="7.8" Foreground="{ThemeResource TextMutedBrush}"
                                       HorizontalAlignment="Right" Margin="0,0,2,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Global notices -->
                    <StackPanel Grid.Row="1" Margin="28,0,28,8" Spacing="6">
                        <InfoBar IsOpen="{Binding HasWarning}" Severity="Warning" Title="扫描提示" Message="{Binding WarningText}"
                                 IsClosable="False" />
                        <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="扫描失败" Message="{Binding ErrorMessage}"
                                 IsClosable="False" />
                        <InfoBar x:Name="ActionInfoBar" Severity="Success" Title="操作完成" IsOpen="False" IsClosable="True" />
                    </StackPanel>

                    <!-- Views -->
                    <Grid Grid.Row="2" Margin="28,0,20,14">
                        <views:OverviewView x:Name="OverviewView" Visibility="Visible" />
                        <views:PortMapView x:Name="PortMapView" Visibility="Collapsed" />
                        <views:DevicesView x:Name="DevicesView" Visibility="Collapsed" />
                        <views:AboutView x:Name="AboutView" Visibility="Collapsed" />
                        <views:CreditsView x:Name="CreditsView" Visibility="Collapsed" />
                        <views:SettingsView x:Name="SettingsView" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <!-- Scanning overlay -->
        <Grid x:Name="ScanOverlay" Grid.RowSpan="2" Background="{ThemeResource ScanOverlayBrush}"
              Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing Width="42" Height="42" IsActive="True" Foreground="{ThemeResource CyanBrush}" />
                <TextBlock Text="正在读取 USB 拓扑" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="SetupAPI · USB Hub IOCTL · 设备描述符" FontSize="8.5"
                           Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
